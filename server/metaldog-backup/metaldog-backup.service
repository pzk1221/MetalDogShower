[Unit]
Description=MetalDogShower private history backup
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=metaldog
Group=metaldog
WorkingDirectory=/opt/metaldog-backup
ExecStart=/usr/bin/python3 /opt/metaldog-backup/server.py
Restart=on-failure
RestartSec=3s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/metaldog-backup
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
